# Copy this file to .env before using compose.yaml.
# Generate a strong local key, for example:
#   openssl rand -hex 32
KITT_PROXY_API_KEY=replace-with-a-long-random-value

# Browser-backed provider started by the reverse proxy.
KITT_PROXY_PROVIDER=chatgpt

# Host loopback ports. CDP itself is intentionally not published.
KITT_PROXY_PORT=3000
KITT_BROWSER_UI_PORT=6080

# Keep headless for normal operation. Switch to headed only for manual login.
KITT_BROWSER_MODE=headless

# Workspace mounted into the Agent container.
KITT_WORKSPACE=.

# Published GHCR image versions. `latest` tracks the newest stable release.
# Pin exact immutable release tags (for example v3.1.0) for reproducible deployments.
KITT_AGENT_VERSION=latest
KITT_REVERSE_PROXY_VERSION=latest

# Optional image repository overrides.
KITT_AGENT_IMAGE=ghcr.io/rfdetoni/kitt-agent-cli
KITT_REVERSE_PROXY_IMAGE=ghcr.io/rfdetoni/kitt-reverse-proxy
KITT_BROWSER_IMAGE=ghcr.io/rfdetoni/kitt-reverse-proxy-browser

# Source refs are used by the Compose build fallback and development builds.
KITT_AGENT_REF=main
KITT_REVERSE_PROXY_REF=main
